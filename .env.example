# Phase 0B: set DATABASE_URL privately in the ignored root .env.
# Use local PostgreSQL port 5432 and database ai_video_editor. Never commit credentials.
DATABASE_URL=
# Later phases only; no API or media processing is enabled.
OPENAI_API_KEY=

# Future media integration accepts explicit executable paths, including spaces.
# Values must never be exposed through NEXT_PUBLIC_* variables.
FFMPEG_PATH=
FFPROBE_PATH=

# Absolute local runtime directory, preferably outside this repository.
# Example on Windows: D:/Projects/AI-Video-Editor-media
MEDIA_ROOT=
MAX_FILES_PER_PROJECT=20
MAX_FILE_SIZE_BYTES=1000000000
MAX_PROJECT_STORAGE_BYTES=5000000000
UPLOAD_RESERVATION_TTL_SECONDS=86400
