# Phase 0B: set DATABASE_URL privately in the ignored root .env.
# Use local PostgreSQL port 5432 and database ai_video_editor. Never commit credentials.
DATABASE_URL=
# Reserved for later phases. Phase 0E makes no OpenAI API calls.
OPENAI_API_KEY=

# Technical processing accepts explicit executable paths, including spaces.
# Values must never be exposed through NEXT_PUBLIC_* variables.
FFMPEG_PATH=
FFPROBE_PATH=

# Absolute local runtime directory, preferably outside this repository.
# Example on Windows: D:/Projects/AI-Video-Editor-media
MEDIA_ROOT=
MAX_FILES_PER_PROJECT=20
MAX_FILE_SIZE_BYTES=1000000000
MAX_PROJECT_STORAGE_BYTES=5000000000
UPLOAD_RESERVATION_TTL_SECONDS=86400

# Phase 0E deterministic technical processing defaults. FFmpeg paths may stay
# blank when both executables are available on PATH.
MAX_FILE_DURATION_MS=900000
MAX_PROJECT_DURATION_MS=1800000
TECHNICAL_MAX_EDGE=1920
MAX_WORKING_BYTES_PER_PROJECT=5000000000
TECHNICAL_SCENE_THRESHOLD=0.30
TECHNICAL_MAX_SEGMENT_FRAMES=300
TECHNICAL_MAX_FRAMES_PER_ASSET=300
